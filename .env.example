# Copy this file to .env and fill in values for local development.
# Authentication uses DefaultAzureCredential (run `az login`); no API keys here.

# Required: Microsoft Foundry project endpoint, for example:
# https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_ENDPOINT=

# Required: model deployment name in the Foundry project.
FOUNDRY_MODEL_DEPLOYMENT=claude-haiku-4-5

# Optional telemetry connection string for Application Insights tracing.
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Optional app-specific integrations to wire up later.
IT_SUPPORT_KNOWLEDGE_BASE_PATH=
TICKETING_API_BASE_URL=
